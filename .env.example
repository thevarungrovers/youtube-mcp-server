# All settings are OPTIONAL. Copy to .env and fill in what you have.

# API key for public, read-only calls (channel/video/playlist data, search).
# Not needed if you have run `python cli.py auth` -- OAuth covers everything.
YOUTUBE_API_KEY=your_api_key_here

# Default channel for API-key-only use, where "my channel" is unknown.
# A channel ID (UC...) or a handle (@name). Ignored when OAuth is set up and
# no channel is passed (the authenticated channel is used instead).
# YOUTUBE_CHANNEL_ID=

# Override where the OAuth files live (defaults: project root).
# YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# YOUTUBE_TOKEN_FILE=token.json

# Slack-compatible incoming webhook for `cli.py report` / `cli.py alerts`
# (optional; treat it as a secret).
# YOUTUBE_REPORT_WEBHOOK=
